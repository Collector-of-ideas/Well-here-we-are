<script>
function toggleSection(name) {
    const sections = document.querySelectorAll('.nav-section');
    sections.forEach(s => {
        const header = s.querySelector('.header-style');
        if (s.dataset.section === name) {
            const isOpen = s.classList.contains('active');
            s.classList.toggle('active', !isOpen);
            header.classList.toggle('filled', !isOpen);
            header.classList.toggle('outline', isOpen);
        }
    });
}

function toggleHamburger() {
    const menu = document.getElementById('customMenu');
    menu.classList.toggle('is-open');
}

function syncUI() {
    const currentPath = window.location.pathname;
    document.querySelectorAll('.nav-grid-item').forEach(el => el.classList.remove('current'));

    if (currentPath.includes('page121569176.html')) {
        const storyLink = document.querySelector('[href="/page121569176.html"]');
        if (storyLink) storyLink.classList.add('current');
    } else if (currentPath.includes('page126749676.html')) {
        const mapLink = document.querySelector('.map-link');
        if (mapLink) mapLink.classList.add('current');
    }
}

window.addEventListener('load', syncUI);
</script>
